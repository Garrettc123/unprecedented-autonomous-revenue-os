STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (SendGrid or equivalent — must support unsubscribe)
SENDGRID_API_KEY=SG....
FROM_EMAIL=hello@garcar.io
