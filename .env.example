PHYSICAL_ADDRESS="Your real business address for CAN-SPAM"

# Event Bus + Observability (Redis — shared with garcar-enterprise-sync-core)
REDIS_URL=redis://localhost:6379/0
# Railway: REDIS_URL=${{Redis.REDIS_URL}} (private redis.railway.internal). redis-py is dual-stack; no family=0 needed.
# Optional reconnect tuning (seconds)
# REDIS_BACKOFF_BASE=0.5
# REDIS_BACKOFF_MAX=30
# REDIS_HEALTH_INTERVAL=15

# Observability
LINEAR_API_KEY=
NOTION_TOKEN=

# Never commit real secrets
